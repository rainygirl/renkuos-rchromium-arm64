name			chromium
version			154.0.8036.0-1
architecture	arm64
summary			"Chromium web browser"
description		"Chromium built for Haiku on AArch64.

Ozone is the windowing backend and ANGLE is linked statically. Audio goes
through a silent fake device until the Media Kit backend exists.
Renderers run in their own processes and drop root, so they cannot write
your files or kill other applications, but this is not a full sandbox:
Haiku has no seccomp or namespaces, and a compromised renderer can still
read files, open connections and message other applications."
vendor			"The Chromium Authors"
packager		"The RENKU project"
copyrights		{
	"2026 The Chromium Authors"
}
licenses		{
	"BSD (3-clause)"
}
provides {
	chromium = 154.0.8036.0
	app:Chromium = 154.0.8036.0
}
requires {
	haiku_arm64
	lib:libz
	lib:libexecinfo
}
