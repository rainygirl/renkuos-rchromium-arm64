# R Chromium: the //chrome extension APIs content_shell implements itself
# (tabs, action, webNavigation, cookies, extension). The schemas are
# chrome/common/extensions/api's own, copied in by port/apply-haiku-port.sh so
# they always match the checkout; the features below are trimmed from
# chrome/common/extensions/api/_*_features.json. None of //chrome is linked.

import("//extensions/buildflags/buildflags.gni")
import("//extensions/common/api/schema.gni")
import("//tools/json_schema_compiler/json_features.gni")
import("//tools/json_schema_compiler/json_schema_api.gni")

assert(enable_extensions_core)

shell_extensions_api_schema_sources = [
  "cookies.json",
  "tabs.json",
  "web_navigation.json",
]

# Bundled for the renderer bindings but given no C++ types, as in Chrome:
# extension.json refers to runtime.MessageSender, which core marks nocompile,
# and the action functions read their arguments by hand.
shell_extensions_api_uncompiled_sources = [
  "action.json",
  "extension.json",
]

# Referenced by tabs.json and action.json; no API of their own here.
shell_extensions_types_only_schema_sources = [
  "tab_groups.json",
  "windows.json",
]

shell_extensions_api_root_namespace = "extensions::api::%(namespace)s"
shell_extensions_api_schema_include_rules =
    "extensions/common/api:extensions::api::%(namespace)s"

group("api") {
  public_deps = [
    ":api_features",
    ":generated_api_json_strings",
    ":generated_api_types",
    ":permission_features",
  ]
}

generated_json_strings("generated_api_json_strings") {
  sources = shell_extensions_api_schema_sources +
            shell_extensions_types_only_schema_sources +
            shell_extensions_api_uncompiled_sources
  bundle_name = "Shell"
  schema_include_rules = shell_extensions_api_schema_include_rules
  root_namespace = shell_extensions_api_root_namespace
  deps = [ "//extensions/common/api" ]
  inputs = extensions_api_schema_files + extensions_types_only_schema_files
  visibility = [ ":api" ]
}

generated_types("generated_api_types") {
  sources = shell_extensions_api_schema_sources +
            shell_extensions_types_only_schema_sources
  schema_include_rules = shell_extensions_api_schema_include_rules
  root_namespace = shell_extensions_api_root_namespace
  deps = [ "//extensions/common/api" ]
  visibility = [ ":api" ]
}

json_features("api_features") {
  feature_type = "APIFeature"
  method_name = "AddShellAPIFeatures"
  sources = [ "_api_features.json" ]
  visibility = [ ":api" ]
}

json_features("permission_features") {
  feature_type = "PermissionFeature"
  method_name = "AddShellPermissionFeatures"
  sources = [ "_permission_features.json" ]
  visibility = [ ":api" ]
}
